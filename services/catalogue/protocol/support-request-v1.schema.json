{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixture-only support request v1",
  "$comment": "Descriptive only, no schema engine. Maximum input 8192 UTF-8 bytes and JSON nesting 16. Strict parser rejects duplicate/escaped-alias keys, BOM, malformed UTF-8/Unicode, trailing data and all signs, fractions, exponents and unsafe integer number tokens. Code checks presentedAt <= acceptedAt <= submittedAt. Objects have exact own enumerable data properties, Object.prototype or null, no accessor/symbol/custom prototype/cycle/Proxy. Validation does not authenticate consent or establish any production authority. No retention policy is activated. Decode refuses shared backing memory and Proxies without invoking traps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "clientRequestID",
    "submittedAt",
    "app",
    "notes",
    "consent"
  ],
  "properties": {
    "schema": {
      "const": "fixture-support-request-v1"
    },
    "clientRequestID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "submittedAt": {
      "$ref": "#/$defs/time"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "bundleID",
        "version",
        "vendorURL"
      ],
      "properties": {
        "displayName": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "provenance"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "$comment": "Maximum 512 UTF-8 bytes and Unicode scalar validity are additionally checked by code.",
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
              }
            },
            "provenance": {
              "enum": [
                "locallyObserved",
                "userSupplied"
              ]
            }
          }
        },
        "bundleID": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "provenance"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 255,
                  "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$",
                  "not": {
                    "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                  }
                },
                "provenance": {
                  "enum": [
                    "locallyObserved",
                    "userSupplied"
                  ]
                }
              }
            }
          ]
        },
        "version": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "provenance"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "$comment": "Maximum 512 UTF-8 bytes and Unicode scalar validity are additionally checked by code.",
                  "not": {
                    "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                  }
                },
                "provenance": {
                  "enum": [
                    "locallyObserved",
                    "userSupplied"
                  ]
                }
              }
            }
          ]
        },
        "vendorURL": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "provenance"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^https://[^\\s\\\\?#]+$",
                  "$comment": "Maximum 2048 UTF-8 bytes. Code checks literal lowercase HTTPS and lowercase DNS authority, no IP/userinfo/percent hostname/trailing dot, labels 1..63 with no edge hyphens and host <=253, exact WHATWG hostname preservation including refusal of numeric-final-label candidates, absent or canonical decimal port 1..65535, and no parser repair. Raw path @ is allowed; raw query/fragment forbidden. No resolution, fetching or source approval. Literal or percent-encoded dot path segments are refused; ordinary Unicode and percent-encoded path text remain raw."
                },
                "provenance": {
                  "enum": [
                    "userSupplied"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "notes": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 1000,
          "$comment": "Maximum 2048 UTF-8 bytes; valid Unicode scalar text. LF/tab allowed; CR forbidden. Literal text, no anonymisation or rendering-safety claim.",
          "not": {
            "pattern": "[\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]"
          }
        }
      ]
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "purpose",
        "destination",
        "presentedAt",
        "acceptedAt"
      ],
      "properties": {
        "schema": {
          "const": "fixture-support-consent-v1"
        },
        "purpose": {
          "const": "coverage-research"
        },
        "destination": {
          "const": "patched-catalogue-support"
        },
        "presentedAt": {
          "$ref": "#/$defs/time"
        },
        "acceptedAt": {
          "$ref": "#/$defs/time"
        }
      }
    }
  },
  "$defs": {
    "time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
